{
  "analysis_governance": {
    "checkpoint_selection": false,
    "common_target_fp32_ptq_comparison": "only the ten frozen common FP32-representable targets",
    "compute_persistence_modes_must_remain_separate": true,
    "fault_pairs_are_independent_subjects": false,
    "individual_compute_target_detail_required": true,
    "individual_sensor_family_detail_required": true,
    "individual_sensor_severity_detail_required": true,
    "outer_result_based_bit_selection": false,
    "outer_result_based_compute_target_selection": false,
    "outer_result_based_model_selection": false,
    "outer_result_based_pair_resampling": false,
    "outer_result_based_persistence_selection": false,
    "outer_result_based_sensor_family_selection": false,
    "outer_result_based_sensor_severity_selection": false,
    "primary_uncertainty_unit": "outer_subject",
    "ptq_only_targets_in_cross_variant_comparison": false,
    "same_subject_equal_weighting_required": true,
    "temporal_overlap_status_must_be_reported": true,
    "threshold_retuning": false
  },
  "causal_parent_join": {
    "no_cross_fold_pairing": true,
    "no_cross_subject_pairing": true,
    "no_cross_trial_pairing": true,
    "outer_partition_key": [
      "subject",
      "fold"
    ],
    "persistent_compute_pairing": {
      "reason": "preserve exact CC comparator identity; do not select compute targets or onsets based on overlap",
      "rule": "reuse the exact Phase-5 persistent sampling identity for the same subject/task/trial and selected target, including the frozen Phase-5 persistent onset",
      "temporal_overlap_filtering_allowed": false,
      "temporal_overlap_status_must_be_recorded": true
    },
    "sensor_corrupted_parent_must_generate_the_compute_faulted_inference": true,
    "sensor_corruption_precedes_compute_fault": true,
    "sequence_sensor_parent": "source_trial",
    "transient_compute_pairing": {
      "source_trial_sensor_fault": "derive the sensor-exposed evaluation-window set using the frozen Phase-4H historical-truth parent-to-window mapping; choose one exposed evaluation window by SHA256(sensor_replay_id, selected_target, namespace) modulo the ordered exposed-window set; reuse the exact Phase-5 transient sampling identity for that window and selected target",
      "stored_window_sensor_fault": "reuse the exact Phase-5 transient sampling identity for that same trial/window and selected target",
      "zero_exposed_window_policy": "ABORT_PLAN_DERIVATION_NO_FALLBACK"
    },
    "window_sensor_parent": "stored_window"
  },
  "claim_boundary": {
    "CSC_outer_execution_authorized_by_this_protocol": false,
    "MCU_fault_equivalence_claim": false,
    "OnField_fall_performance_claim": false,
    "OnField_used": false,
    "P2_or_P3_realism_claim": false,
    "execution_plan_must_be_frozen_first": true,
    "hardware_fault_rate_claim": false,
    "physical_fault_equivalence_claim": false
  },
  "comparator_contract": {
    "C0": "exact frozen clean model/seed/trial comparator; no recomputation per CSC pair",
    "CC": "same exact Phase-5 compute sampling coordinate, model variant, checkpoint seed and parent, but clean sensor input",
    "CS": "same selected sensor fault instance, same parent, model variant and checkpoint seed, but no compute fault",
    "CSC": "same sensor fault as CS + same compute fault as CC within the same parent",
    "operating_points": [
      "balanced",
      "low_false_alarm",
      "timely_150ms"
    ],
    "same_checkpoint_required": true,
    "same_fold_required": true,
    "same_parent_required": true,
    "same_preprocessing_required": true,
    "same_validation_selected_threshold_required": true,
    "threshold_retuning_allowed": false
  },
  "compute_stratum_assignment": {
    "algorithm": "SHA256 canonical compact sorted JSON; first 8 digest bytes interpreted as big-endian unsigned integer modulo 28",
    "all_28_strata_must_have_nonzero_plan_coverage": true,
    "assignment_payload": [
      "namespace",
      "sensor_fault_id",
      "sensor_replay_id"
    ],
    "canonical_stratum_order": "Phase-5D target_inventory order, then persistence_order",
    "namespace": "crosslayer-phase6d-csc-compute-stratum-assignment-v1",
    "outer_performance_based_reassignment": false,
    "plan_must_report_exact_count_per_stratum": true,
    "rebalancing_after_counts_are_seen": false,
    "unit": "one compute stratum per selected sensor fault instance"
  },
